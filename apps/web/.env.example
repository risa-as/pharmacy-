# ─────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pharmacy_db"

# ─────────────────────────────────────────────────────────
# Auth (NextAuth v5)
# ─────────────────────────────────────────────────────────
AUTH_SECRET="your-nextauth-secret-min-32-chars"

# REQUIRED: HMAC secret used to sign desktop/mobile sync tokens.
# Must be a strong random value (e.g. `openssl rand -hex 32`) and kept secret.
# The app refuses to issue/verify sync tokens if this is unset.
# NOTE: changing this value invalidates existing desktop sync tokens — each
# desktop device must log in again once after it is rotated.
SYNC_TOKEN_SECRET="your-strong-random-sync-secret-min-32-chars"

# OPTIONAL: protects Vercel Cron endpoints (e.g. mobile session cleanup).
# When set, cron requests must send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="your-cron-secret"

# ─────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────
# Full public URL of this deployment — used to build Zain Cash callback URLs
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ─────────────────────────────────────────────────────────
# Zain Cash Payment Gateway
# https://zaincash.iq — Iraqi mobile wallet
# ─────────────────────────────────────────────────────────

# Your merchant account identifier (provided by Zain Cash)
ZAINCASH_MERCHANT_ID="your-merchant-id"

# HMAC-SHA256 signing secret (provided by Zain Cash — keep strictly server-side)
ZAINCASH_MERCHANT_SECRET="your-merchant-secret"

# Merchant's registered Zain Cash phone number (e.g. 07xxxxxxxxx)
ZAINCASH_MSISDN="07xxxxxxxxx"

# Zain Cash API base URL (use sandbox for testing)
# Production : https://api.zaincash.iq
# Sandbox    : https://test.zaincash.iq
ZAINCASH_API_URL="https://test.zaincash.iq"

# ─────────────────────────────────────────────────────────
# Rate Limiting — Upstash Redis (recommended for production)
# https://console.upstash.com → create a Redis database → copy REST keys
# Without these vars the limiter falls back to per-process in-memory state
# (best-effort on serverless — each cold-start resets counters).
# ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ─────────────────────────────────────────────────────────
# Prescription Scan (scan-prescription feature)
# ─────────────────────────────────────────────────────────
# Provider: "gemini" (default) or "vision"
PRESCRIPTION_SCAN_PROVIDER="gemini"

# Gemini AI Vision API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# Gemini model (default: gemini-1.5-flash — free tier; use gemini-2.0-flash for better accuracy)
# GEMINI_MODEL="gemini-1.5-flash"

# Google Cloud Vision OCR key (only needed if PRESCRIPTION_SCAN_PROVIDER=vision)
# GOOGLE_VISION_API_KEY="your-google-vision-api-key"

# ─────────────────────────────────────────────────────────
# AI Pharmacy Assistant (011-ai-assistant)
# ─────────────────────────────────────────────────────────
