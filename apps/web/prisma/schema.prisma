generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  planId             String?
  maxBranches        Int?
  maxUsers           Int?
  maxDevices         Int? // Per-org override for device license limit
  maxMobileUsers     Int? // Per-org override for mobile session limit
  isSuspended        Boolean   @default(false)
  suspendedAt        DateTime?
  subscriptionEndsAt DateTime?
  isTrial            Boolean   @default(false) // true while on a free trial; cleared on first paid renewal
  aiDailyLimit                  Int       @default(50)
  prescriptionScanDailyLimit    Int       @default(20)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  minProfitMargin    Float     @default(5)
  loyaltyEnabled         Boolean  @default(false)
  loyaltyPointsPerDinar  Float    @default(0.01)
  loyaltyRedemptionValue Float    @default(2.5)
  loyaltyMinRedemption   Int      @default(500)

  branches           Branch[]
  paymentTransactions PaymentTransaction[]
  customDrugs        GlobalDrug[] @relation("OrganizationCustomDrugs")
  suppliers          Supplier[]   @relation("OrganizationSuppliers")
  companySettings    CompanySettings?
  aiUsageLogs             AiUsageLog[]
  prescriptionScanLogs    PrescriptionScanLog[]
  invoiceCounter     InvoiceCounter?
  // Phase 2 (الحسابات والعملاء) من نظام المذاخر B2B: هذه المنظمة كصيدلية تتعامل
  // مع مذاخر — علاقة تجارية واحدة لكل (مذخر، منظمة) + فواتيرها الواردة منها.
  warehouseCustomers WarehouseCustomer[]
  warehouseInvoices  WarehouseInvoice[]
  // المندوبون (مذاخر B2B): مبيعات ميدانية حيث كانت هذه المنظمة هي الصيدلية
  // المشترية على منصّتنا (WarehouseFieldSale.organizationId اختياري — قد يكون
  // العميل خارج المنصّة، انظر تعليق النموذج).
  warehouseFieldSales WarehouseFieldSale[]
  supplierLinkRequests SupplierLinkRequest[]

  plan               SubscriptionPlan? @relation(fields: [planId], references: [id])
}

model Branch {
  id                  String               @id @default(uuid())
  name                String
  organizationId      String
  loyaltyEnabled      Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id])
  inventories         Inventory[]
  purchases           Purchase[]
  sales               Sale[]
  users               User[]
  expenses            Expense[]
  patients            Patient[]
  supplierPayments    SupplierPayment[]
  shifts              Shift[]
  safes               Safe[]
  saleReturns         SaleReturn[]
  stocktakes          Stocktake[]
  transfersOut        Transfer[]           @relation("BranchTransfersOut")
  transfersIn         Transfer[]           @relation("BranchTransfersIn")
  warehouseOrders     WarehouseOrder[]
  marketplaceListings MarketplaceListing[] @relation("MarketplaceSeller")
  marketplaceBuys     MarketplaceOrder[]   @relation("MarketplaceBuyer")
  patientAppOrders    PatientAppOrder[]
  demandForecasts     DemandForecast[]
  deviceLicenses      DeviceLicense[]
  notifications       Notification[]
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String?
  role          Role        @default(PHARMACIST)
  branchId      String?
  password      String
  permissions   String? // JSON string of granular permissions
  expoPushToken String? // Expo push token for notifications
  pushEnabled   Boolean     @default(true)
  isActive      Boolean     @default(true) // Soft-disable a departed employee without deleting (preserves sales/shift FKs)
  sessionVersion Int        @default(0) // Bumped to revoke every web/mobile/desktop session (password change, disable)
  // المرحلة 1 من ميزة المذاخر: حساب مذخر لا ينتمي لأي Organization أو Branch.
  warehouseId       String?
  warehouseUserType WarehouseUserType?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  branch        Branch?     @relation(fields: [branchId], references: [id])
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id])
  sales         Sale[]
  shifts        Shift[]
  stocktakes    Stocktake[]
  notifications Notification[]
  // المندوبون (مذاخر B2B): حساب دخول اختياري لمندوب — انظر WarehouseRep.userId.
  warehouseRep  WarehouseRep?

  @@index([warehouseId])
}

model Shift {
  documentNumber String @unique @default(dbgenerated("next_document_reference('SHF'::text)"))
  id           String    @id @default(uuid())
  userId       String
  branchId     String
  safeId       String? // Ensure this shift is tied to a specific cash drawer/safe
  startTime    DateTime  @default(now())
  endTime      DateTime?
  duration     Float     @default(0) // In hours
  startingCash Float     @default(0)
  expectedCash Float     @default(0)
  actualCash   Float?
  status       String    @default("OPEN") // OPEN, CLOSED
  user         User      @relation(fields: [userId], references: [id])
  branch       Branch    @relation(fields: [branchId], references: [id])
  safe         Safe?     @relation(fields: [safeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Safe {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("CASH_DRAWER") // CASH_DRAWER, BANK, VAULT, MOBILE_WALLET
  balance   Float    @default(0)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts           Shift[]
  transactions     Transaction[]
  sales            Sale[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]
  saleReturns      SaleReturn[]
}

model Transaction {
  id            String   @id @default(uuid())
  safeId        String
  type          String // IN, OUT
  amount        Float
  referenceType String // SALE, EXPENSE, SUPPLIER_PAYMENT, CUSTOMER_RECEIPT, TRANSFER
  referenceId   String? // ID of the related record
  description   String?
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  safe Safe @relation(fields: [safeId], references: [id])

  @@index([safeId])
  @@index([safeId, createdAt])
  @@index([referenceId])
}

model GlobalDrug {
  id                   String                @id @default(uuid())
  barcode              String
  tradeName            String
  scientificName       String
  origin               String?
  image                String?
  isActive             Boolean               @default(true)
  isQuickSale          Boolean               @default(false)
  alternatives         String[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inventories          Inventory[]
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
  saleReturnItems      SaleReturnItem[]
  transferItems        TransferItem[]
  warehouseOrderItems  WarehouseOrderItem[]
  marketplaceListings  MarketplaceListing[]
  patientAppOrderItems PatientAppOrderItem[]
  demandForecasts      DemandForecast[]
  warehouseCatalogItems WarehouseCatalogItem[]

  organizationId       String?
  organization         Organization? @relation("OrganizationCustomDrugs", fields: [organizationId], references: [id])

  // ميزة نطاق المذخر: الصف قد يكون خاصاً بمذخر بعينه بنفس فلسفة organizationId
  // أعلاه. النطاق صار ثنائياً: (null,null) = الكتالوج العالمي المشترك،
  // (orgId,null) = خاص بمؤسسة، (null,warehouseId) = خاص بمذخر. الترقية إلى
  // العالمي = تصفير حقل النطاق فقط، فتبقى كل المفاتيح الأجنبية سليمة —
  // انظر globalizeWarehouseDrugs في app/lib/actions/drugs-globalize.ts.
  warehouseId          String?
  warehouse            Warehouse? @relation("WarehouseCustomDrugs", fields: [warehouseId], references: [id])

  // ميزة وحدة التسعير: عدد الأشرطة في الباكيت الواحد لهذا الدواء.
  // يُخزَّن هنا **مرة واحدة لكل باركود** لا لكل مؤسسة ولا لكل مورد — بقرار
  // صاحب النظام: التعبئة خاصية بالدواء نفسه ومطابقة لجميع الموردين، فأي نسخة
  // ثانية منها (على Inventory مثلاً) تخلق مصدرَي حقيقة يتعارضان.
  //
  // NULL = «غير معروف بعد»، وهي القيمة الحالية لكل الصفوف بلا استثناء وبقرار
  // صريح: لا تُعبَّأ هذه الأعمدة بتخمين ولا باشتقاق من نِسَب الأسعار. كل مستهلك
  // لها ملزَم بالتصرّف الصحيح عند NULL — أي **المنع والمراجعة** لا التخمين،
  // انظر app/lib/pack-units.ts (toStripPrice) وهي القاعدة الحسابية الوحيدة.
  unitsPerPack         Int?
  // متى أكّد صيدلاني هذا العدد بنفسه وهو ينظر إلى العلبة.
  // NULL = **لم يؤكّده أحد** — إمّا فارغ أصلاً، أو رقم مستنتَج من الدفعات القديمة
  // (نحو نصفه غير دقيق). التمييز بين «رقم موجود» و«رقم مُتحقَّق منه» هو جوهر
  // الآلية: الرقم وحده لا يكفي للثقة، ولذلك لا يُستغنى عن هذا الحقل بفحص
  // unitsPerPack IS NOT NULL.
  //
  // مشترك بين كل الصيدليات بقرار صاحب النظام: أول من يؤكّد العدد يُعتمد تأكيده
  // للجميع فلا يُسأل عنه أحد بعده — التعبئة خاصية بالمنتج لا بالصيدلية.
  unitsPerPackConfirmedAt DateTime?

  @@unique([barcode, organizationId])
  // قيد منفصل عن الذي فوقه بقصد: Postgres يعتبر NULL مميزاً، فلو أُدمج
  // warehouseId في نفس الثلاثية لصار صفوف المؤسسات تحمل NULL في الثلاثية
  // فتفقد حمايتها الحالية بصمت. القيد أدناه يُفعَّل فقط حين warehouseId غير null.
  @@unique([barcode, warehouseId])
  @@index([tradeName])
  @@index([barcode])
  @@index([warehouseId])
}

model Inventory {
  id        String     @id @default(uuid())
  branchId  String
  drugId    String
  drug      GlobalDrug @relation(fields: [drugId], references: [id])
  price     Float
  cost      Float
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  maxStock  Int        @default(1000)
  minStock  Int        @default(1)
  /// Quick-sale shortcut for this branch's stock (N09). GlobalDrug.isQuickSale
  /// is shared by every organisation and is no longer read or written.
  isQuickSale Boolean  @default(false)
  batches   Batch[]
  branch    Branch     @relation(fields: [branchId], references: [id])

  @@unique([drugId, branchId])
  @@index([branchId])
  @@index([branchId, minStock])
}

model Batch {
  id              String          @id @default(uuid())
  purchaseItemId  String?
  inventoryId     String
  expiryDate      DateTime
  quantity        Int
  // Original quantity received; `quantity` is decremented on sale/transfer/write-off,
  // so consumed = initialQuantity - quantity. Backfilled as = quantity for pre-existing rows.
  initialQuantity Int             @default(0)
  batchNumber     String
  costPrice       Float           @default(0)
  supplierId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inventory       Inventory       @relation(fields: [inventoryId], references: [id])
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stocktakeItems  StocktakeItem[]

  @@index([inventoryId])
  @@index([inventoryId, expiryDate])
  @@index([expiryDate, quantity])
}

model Expense {
  id          String   @id @default(uuid())
  branchId    String
  safeId      String?
  amount      Float
  category    String // e.g., Rent, Utilities, Salaries
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])
  safe        Safe?    @relation(fields: [safeId], references: [id])

  @@index([branchId])
  @@index([branchId, date])
}

model SyncActionLog {
  idempotencyKey String   @id
  actionType     String // e.g., 'SALE', 'INVENTORY_ADD', 'CREATE_DRUG'
  branchId       String
  status         String   @default("PROCESSED") // 'PROCESSED', 'FAILED'
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([actionType])
  @@index([branchId])
}

model Sale {
  /// N16: true when the desktop proved userId with a server-issued operator
  /// proof; false = attribution claimed but not proven; null = not a desktop sync.
  operatorVerified Boolean?
  documentNumber String @unique @default(dbgenerated("next_document_reference('INV'::text)"))
  id               String        @id @default(uuid())
  invoiceNumber    Int?
  branchId         String
  safeId           String? // The safe where the cash for this sale went
  patientId        String? // Linked to CRM
  total            Float
  discount         Float         @default(0)
  hasPriceOverride Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch       Branch        @relation(fields: [branchId], references: [id])
  safe         Safe?         @relation(fields: [safeId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  items        SaleItem[]
  payment      Payment?
  debtPayments DebtPayment[]
  returns      SaleReturn[]
  userId       String? // Employee who made the sale
  user         User?         @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([createdAt])
  @@index([branchId, createdAt])
}

model InvoiceCounter {
  organizationId String       @id
  nextNumber     Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_WALLET
  BANK_TRANSFER
  ZAIN_CASH
  STRIPE
  CREDIT
}

model SaleItem {
  batchAllocations String? // Immutable batch ids and quantities deducted for this line.
  id            String     @id @default(uuid())
  saleId        String
  drugId        String
  quantity      Int
  price         Float
  originalPrice Float?
  cost          Float      @default(0)
  sale          Sale       @relation(fields: [saleId], references: [id])
  drug          GlobalDrug @relation(fields: [drugId], references: [id])

  @@index([saleId])
  @@index([drugId])
}

model SaleReturn {
  documentNumber String @unique @default(dbgenerated("next_document_reference('RTN'::text)"))
  id           String   @id @default(uuid())
  returnNumber String?  @unique // Independent return invoice number
  saleId       String
  branchId     String
  safeId       String? // The safe used to refund the customer, if CASH
  userId       String? // Cashier who processed the return (for audit attribution)
  total        Float
  createdAt    DateTime @default(now())
  notes        String?

  sale   Sale             @relation(fields: [saleId], references: [id])
  branch Branch           @relation(fields: [branchId], references: [id])
  safe   Safe?            @relation(fields: [safeId], references: [id])
  items  SaleReturnItem[]

  @@index([branchId])
  @@index([branchId, createdAt])
}

model SaleReturnItem {
  batchAllocations String?
  stockStatus String @default("LEGACY") // RESTOCKED, QUARANTINED, DISPOSED; LEGACY predates tracking.
  stockReviewNote String?
  stockReviewedBy String?
  stockReviewedAt DateTime?
  id           String @id @default(uuid())
  saleReturnId String
  drugId       String
  quantity     Int
  price        Float // The price at which it was refunded

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  drug       GlobalDrug @relation(fields: [drugId], references: [id])

  @@index([saleReturnId])
  @@index([drugId])
}

model Supplier {
  id        String            @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  balance   Float             @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  
  organizationId String?
  organization   Organization? @relation("OrganizationSuppliers", fields: [organizationId], references: [id])

  purchases Purchase[]
  payments  SupplierPayment[]
  batches   Batch[]
  // المرحلة 2 من ميزة المذاخر: المورد المرآة لمذخر على المنصة (يُنشأ تلقائياً عند أول طلب معتمد — التقرير §4.1-ب).
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  linkRequests SupplierLinkRequest[]

  @@unique([organizationId, warehouseId])
}

// طلب ربط مورد محلي بمذخر: ترفعه المؤسسة من صفحة الموردين ويعتمده مدير المنصة.
// الربط نفسه يبقى صلاحية SUPER_ADMIN حصراً (admin/warehouses/[id]/supplier-links)
// لأنه يوجّه فواتير مذخر إلى سجل محاسبي؛ هذا الجدول يسجّل الطلب والقرار فقط.
model SupplierLinkRequest {
  id             String    @id @default(uuid())
  organizationId String
  supplierId     String
  warehouseId    String
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status         String    @default("PENDING")
  /// = supplierId طالما الطلب معلّق ثم NULL عند الحسم. قيد فريد عادي (NULL مميز في
  /// Postgres) يمنع طلبين معلّقين لنفس المورد بلا فهرس جزئي لا يعرفه Prisma.
  pendingKey      String?   @unique
  note            String?
  requestedById   String
  requestedByName String?
  decidedById     String?
  decidedByName   String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([status, createdAt])
  @@index([organizationId, status])
  @@index([warehouseId])
  @@index([supplierId])
}

model Purchase {
  documentNumber String @unique @default(dbgenerated("next_document_reference('PUR'::text)"))
  id            String         @id @default(uuid())
  warehouseOrderId String?      @unique
  supplierId    String
  branchId      String
  total         Float
  paidAmount    Float          @default(0)
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invoiceNumber String?
  signature     String?
  branch        Branch         @relation(fields: [branchId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@index([branchId])
  @@index([branchId, status])
  @@index([supplierId])
}

model PurchaseItem {
  id          String     @id @default(uuid())
  purchaseId  String
  drugId      String
  quantity    Int
  cost        Float
  expiryDate  DateTime?
  batchNumber String?
  purchase    Purchase   @relation(fields: [purchaseId], references: [id])
  drug        GlobalDrug @relation(fields: [drugId], references: [id])

  @@index([purchaseId])
  @@index([drugId])
}

model SupplierPayment {
  id         String   @id @default(uuid())
  supplierId String
  branchId   String
  safeId     String?
  amount     Float
  method     String   @default("CASH")
  reference  String?
  notes      String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])
  safe       Safe?    @relation(fields: [safeId], references: [id])

  @@index([supplierId])
  @@index([branchId, date])
}

// ==================== الميزات الجديدة ====================

// سجل المرضى
model Patient {
  id                String            @id @default(uuid())
  name              String
  phone             String
  dateOfBirth       DateTime?
  gender            String?
  allergies         String[]
  chronicDiseases   String[]
  notes             String?
  balance           Float             @default(0) // الرصيد المدين (الديون)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  prescriptions     Prescription[]
  insurancePolicies InsurancePolicy[]
  sales             Sale[]
  loyaltyAccount    LoyaltyAccount?
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id])

  @@unique([phone, branchId])
  @@index([branchId])
  @@index([branchId, balance])
  @@index([updatedAt])
}

// الوصفات الطبية
model Prescription {
  id         String             @id @default(uuid())
  patientId  String
  doctorName String?
  clinicName String?
  issueDate  DateTime           @default(now())
  status     PrescriptionStatus @default(PENDING)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items      PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  drugId         String
  quantity       Int
  dosage         String?
  instructions   String?
  isDispensed    Boolean      @default(false)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

// التأمين الصحي
model InsuranceCompany {
  id           String            @id @default(uuid())
  name         String
  discountRate Float             @default(0)
  contactPhone String?
  contactEmail String?
  isActive     Boolean           @default(true)
  /// Owning organisation (N20). Null = no organisation owns it: either a
  /// platform record (isPlatformShared) or a legacy row of unknown ownership,
  /// hidden from organisations until SUPER_ADMIN settles it.
  organizationId String?
  /// N20: SUPER_ADMIN-approved platform record readable by every organisation.
  isPlatformShared Boolean @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  policies     InsurancePolicy[]

  @@index([organizationId])
}

model InsurancePolicy {
  id           String           @id @default(uuid())
  patientId    String
  companyId    String
  policyNumber String
  expiryDate   DateTime
  coverageRate Float            @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  company      InsuranceCompany @relation(fields: [companyId], references: [id])
}

// الدفع الإلكتروني
model Payment {
  id              String        @id @default(uuid())
  saleId          String        @unique
  amount          Float
  method          PaymentMethod
  referenceNumber String?
  status          PaymentStatus @default(COMPLETED)
  createdAt       DateTime      @default(now())
  sale            Sale          @relation(fields: [saleId], references: [id])
}

// الخصومات والعروض
model Discount {
  id          String       @id @default(uuid())
  name        String
  code        String?      @unique
  type        DiscountType
  value       Float
  minPurchase Float        @default(0)
  maxDiscount Float?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(true)
  applyToAll  Boolean      @default(false)
  drugIds     String[]
  /// Owning organisation (N20). Null = no organisation owns it: either a
  /// platform record (isPlatformShared) or a legacy row of unknown ownership,
  /// hidden from organisations until SUPER_ADMIN settles it.
  organizationId String?
  /// N20: SUPER_ADMIN-approved platform record readable by every organisation.
  isPlatformShared Boolean @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([organizationId])
}

// ==================== Enums ====================

enum Role {
  ADMIN
  SUPER_ADMIN
  PHARMACIST
  CASHIER
  WAREHOUSE
}

// المرحلة 1 من ميزة المذاخر (B2B): نوع مستخدم المذخر — مالك أو موظف.
enum WarehouseUserType {
  OWNER
  STAFF
  // المرحلة 3 (الأدوار والصلاحيات): STAFF أعلاه أصبح دوراً قديماً (DEPRECATED)
  // — لا يُسند بعد الآن لحساب جديد ولا تعرضه واجهة app/warehouse/users كخيار
  // قابل للاختيار؛ أُبقي عليه في التعداد فقط لأن Postgres لا يستطيع حذف قيمة
  // enum قد تشير إليها صفوف موجودة فعلاً بلا إعادة كتابة الجدول بالكامل. وقت
  // التشغيل الفعلي، app/lib/warehouse-permissions.ts يعامل أي صف STAFF قديم
  // كمرادف تام لـ SALES (نفس مصفوفة الصلاحيات الافتراضية بالضبط).
  MANAGER
  SALES
  INVENTORY
  ACCOUNTANT
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ==================== الإعدادات العامة ====================
model CompanySettings {
  id                     String        @id @default(uuid())
  organizationId         String?       @unique
  name                   String        @default("Pharmacy System")
  phone                  String?
  address                String?
  email                  String?
  website                String?
  logoUrl                String?
  taxNumber              String?
  facebookUrl            String?
  instagramUrl           String?
  currency               String        @default("IQD")
  loyaltyEnabled         Boolean       @default(false)
  loyaltyPointsPerDinar  Float         @default(0.01)
  loyaltyRedemptionValue Float         @default(2.5)
  loyaltyMinRedemption   Int           @default(500)
  maxDiscountPercent     Float         @default(10)
  minProfitMargin        Float         @default(5) // Minimum profit margin percentage - warn if selling below this
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization           Organization? @relation(fields: [organizationId], references: [id])
}

// ==================== برنامج الولاء ====================

model LoyaltyAccount {
  id             String               @id @default(uuid())
  patientId      String               @unique
  totalPoints    Int                  @default(0)
  lifetimePoints Int                  @default(0)
  tier           String               @default("BRONZE")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id          String         @id @default(uuid())
  accountId   String
  type        String // EARN or REDEEM
  points      Int
  description String?
  saleId      String?
  createdAt   DateTime       @default(now())
  account     LoyaltyAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([createdAt])
}

model Backup {
  id             String   @id @default(uuid())
  name           String
  url            String
  size           Int
  branchId       String? // optional branch reference — no FK to allow orphaned backups
  organizationId String? // owning org (denormalised so org-level scoping survives branch deletion)
  createdAt      DateTime @default(now())

  @@index([branchId])
  @@index([organizationId])
}

// ==================== دفتر الديون ====================
model DebtPayment {
  id        String        @id @default(uuid())
  saleId    String
  userId    String? // Cashier who recorded the payment (for audit attribution)
  /// N16: true when the desktop proved userId with a server-issued operator
  /// proof; false = attribution claimed but not proven; null = not a desktop sync.
  operatorVerified Boolean?
  amount    Float
  method    PaymentMethod @default(CASH)
  note      String?
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

// ==================== إعدادات المنصة (سجل واحد) ====================
// Platform-wide settings managed by SUPER_ADMIN and shown to all tenants
// (e.g. the SaaS company's bank-transfer details on the billing page).
model PlatformSettings {
  id             String   @id @default("singleton")
  bankName       String?
  accountHolder  String?
  accountNumber  String?
  superKeyPhone  String? // Super Key wallet phone (linked to the same Rafidain account)
  zainCashNumber String? // ZainCash account number / phone (separate payment method)
  supportPhone   String? // WhatsApp number for receipts
  supportEmail   String?
  workingHours   String? // e.g. "9 صباحاً – 5 مساءً"
  transferNote   String? // optional extra instructions shown under the account

  // Download page (www.faramace.com/download) — managed by SUPER_ADMIN, served
  // to the separate landing app via /api/public/download-info.
  downloadWindowsUrl     String? // direct .exe download link
  downloadWindowsVersion String? // e.g. "1.0.0"
  downloadWindowsSize    String? // e.g. "110 MB"
  downloadAndroidUrl     String? // direct .apk download link
  downloadAndroidVersion String? // e.g. "1.0.0"
  downloadAndroidSize    String? // e.g. "110 MB"

  updatedAt      DateTime @updatedAt
}

// ==================== التفاعلات الدوائية ====================
model DrugInteraction {
  id          String   @id @default(uuid())
  drug1       String // Scientific Name 1
  drug2       String // Scientific Name 2
  severity    String // HIGH, MODERATE, LOW
  description String
  createdAt   DateTime @default(now())

  @@unique([drug1, drug2])
  @@index([drug1])
  @@index([drug2])
}

// ==================== الجرد الفعلي وتسوية المخزون ====================
model Stocktake {
  documentNumber String @unique @default(dbgenerated("next_document_reference('STK'::text)"))
  id                     String   @id @default(uuid())
  branchId               String
  status                 String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  totalDiscrepancyAmount Float    @default(0) // Financial value of the difference (+/-)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  userId                 String // User who initiated the stocktake

  branch Branch          @relation(fields: [branchId], references: [id])
  user   User            @relation(fields: [userId], references: [id])
  items  StocktakeItem[]
}

model StocktakeItem {
  id             String  @id @default(uuid())
  stocktakeId    String
  batchId        String // Specific batch being counted
  systemQuantity Int // What the DB said
  actualQuantity Int // What the user counted
  difference     Int // actual - system
  costPrice      Float // Cost price at the time of stocktake to calculate financial impact
  reason         String? // EXPIRED, DAMAGED, MISSING, FOUND

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id])

  @@index([stocktakeId])
  @@index([batchId])
}

// =======================
// Branch Transfers Models
// =======================

model Transfer {
  documentNumber String @unique @default(dbgenerated("next_document_reference('TRF'::text)"))
  id           String   @id @default(uuid())
  fromBranchId String
  toBranchId   String
  status       String   @default("PENDING") // PENDING, IN_TRANSIT, COMPLETED, CANCELLED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromBranch Branch         @relation("BranchTransfersOut", fields: [fromBranchId], references: [id])
  toBranch   Branch         @relation("BranchTransfersIn", fields: [toBranchId], references: [id])
  items      TransferItem[]
}

model TransferItem {
  id          String   @id @default(uuid())
  transferId  String
  drugId      String
  batchNumber String
  expiryDate  DateTime
  quantity    Int
  costPrice   Float    @default(0)

  transfer Transfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  drug     GlobalDrug @relation(fields: [drugId], references: [id])
}

// =======================
// Audit Log
// =======================
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  action    String // CREATE, UPDATE, DELETE, RETURN, LOGIN, PRICE_CHANGE, etc.
  entity    String // SALE, INVENTORY, DRUG, USER, EXPENSE, TRANSFER, etc.
  entityId  String?
  details   String? // JSON string with old/new values or description
  ipAddress String?
  branchId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([branchId])
  @@index([branchId, createdAt])
}

// =======================
// المرحلة 3: المستودعات العراقية
// =======================
model Warehouse {
  operatingMode String @default("ORDER_PORTAL")
  id            String           @id @default(uuid())
  name          String
  code          String?          @unique
  phone         String?
  salesPhone    String?
  followupPhone String?
  managementPhone String?
  address       String?
  city          String?
  contactPerson String?
  email         String?
  apiEndpoint   String?
  apiKey        String?
  isActive      Boolean          @default(true)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  orders        WarehouseOrder[]
  users         User[]
  // المرحلة 2 من ميزة المذاخر: كتالوج المذخر والموردون المرآة.
  catalogItems      WarehouseCatalogItem[]
  mirroredSuppliers Supplier[]
  supplierLinkRequests SupplierLinkRequest[]
  // Phase 2 (الحسابات والعملاء) من نظام المذاخر B2B: العلاقات التجارية والفواتير
  // والدفعات على جانب المذخر — انظر تعليق WarehouseCustomer أدناه.
  customers WarehouseCustomer[]
  invoices  WarehouseInvoice[]
  payments  WarehousePayment[]
  // مشتريات المذخر وذممه الدائنة (اتجاه معاكس لـ invoices/payments أعلاه) —
  // انظر تعليق WarehouseSupplier أدناه.
  suppliers        WarehouseSupplier[]
  purchases        WarehousePurchase[]
  supplierPayments WarehouseSupplierPayment[]
  // المندوبون (مذاخر B2B): تتبّع بضاعة السيارة، الفواتير الميدانية، والتحصيل —
  // انظر تعليق WarehouseRep أدناه.
  reps           WarehouseRep[]
  fieldSales     WarehouseFieldSale[]
  repCollections WarehouseRepCollection[]
  // ميزة نطاق المذخر: أدوية أضافها هذا المذخر ولم تُرقَّ بعد إلى الكتالوج العالمي.
  customDrugs    GlobalDrug[] @relation("WarehouseCustomDrugs")
}

model WarehouseOrder {
  shipmentMode String?
  externalShipment Json?
  id           String               @id @default(uuid())
  warehouseId  String
  branchId     String
  orderNumber  String?              @unique @default(dbgenerated("next_warehouse_order_number()"))
  legacyOrderNumber String?
  // Client-generated key makes retries of the same create operation harmless.
  idempotencyKey String?            @unique
  status       WarehouseOrderStatus @default(DRAFT)
  totalAmount  Float                @default(0)
  notes        String?
  expectedDate DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // ميزة وحدة التسعير — قرار صاحب النظام 2026-09: «كل أسعار المذاخر أسعار
  // باكيت». PACKET صارت قاعدة غير مشروطة داخل toStripPrice (app/lib/pack-units.ts)
  // بصرف النظر عن قيمة هذا العمود، فلم يعد يُقرأ ولا يُكتَب في أي مسار. أُبقي
  // العمود بلا حذف لأنه nullable على قاعدة إنتاج حيّة (حذف عمود أخطر من تركه).
  priceUnit    String?

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  branch    Branch               @relation(fields: [branchId], references: [id])
  items     WarehouseOrderItem[]
  events    WarehouseOrderEvent[]
}

model WarehouseOrderItem {
  id               String @id @default(uuid())
  unitsPerPack     Int?
  warehouseOrderId String
  drugId           String
  quantity         Int
  unitPrice        Float  @default(0)

  // المرحلة 2 من ميزة المذاخر: تفاصيل تفاوض المذخر لكل صنف.
  requestedPrice Float?
  quotedPrice    Float?
  quotedQuantity Int?
  status         WarehouseOrderItemStatus @default(REQUESTED)
  note           String?

  // ميزة البونص: الوحدات المجانية المعتمَدة فعلياً لهذا السطر — قد تُقترَح
  // ابتداءً من WarehouseCatalogItem.bonusThreshold/bonusQuantity أعلاه لكن
  // هذا الحقل هو مصدر الحقيقة الوحيد المستخدَم في الخصم/الفوترة/الهامش (انظر
  // effectiveLine في app/lib/warehouse-quote.ts: البونص لا يدخل حساب السعر أو
  // الإجمالي إطلاقاً — إيراده صفر دوماً — لكن يدخل خصم المخزون والتكلفة كاملاً).
  bonusQuantity Int @default(0)

  // ميزة نقل الدفعة/الانتهاء عند التسعير (2026-09): ما يُعلنه المذخر لهذا
  // الصنف وقت التسعير — إلى جانب السعر والبونص أعلاه. القرار: أغلب مذاخر
  // البوابة المجانية لن تتبنّى تتبّع مخزون (WarehouseBatch/WarehouseStockMove)
  // إطلاقاً، فلا يوجد مصدر آخر لرقم الدفعة/تاريخ الانتهاء يصل الصيدلية أصلاً —
  // هذان الحقلان هما الطريق الوحيد المتاح لمذخر كهذا.
  //
  // كلاهما **وعدٌ لا إثبات**: يُدخَلان قبل أن يُنتقى الشحن فعلياً من الرفّ، فقد
  // يختلف ما يُشحَن فعلاً عمّا صُرِّح به هنا. حين يتتبّع المذخر مخزونه فعلاً
  // فالمشتق من تخصيص FEFO الحقيقي عند الشحن (WarehouseStockMove → WarehouseBatch،
  // عبر app/lib/shipped-batch-prefill.ts) هو الأصدق ويتقدّم عليهما دائماً عند
  // الاستلام — انظر قاعدة الأولوية في app/dashboard/purchases/[id]/receive/page.tsx.
  batchNumber String?
  expiryDate  DateTime?

  warehouseOrder WarehouseOrder @relation(fields: [warehouseOrderId], references: [id], onDelete: Cascade)
  drug           GlobalDrug     @relation(fields: [drugId], references: [id])
}

enum WarehouseOrderStatus {
  DRAFT
  SENT
  UNDER_REVIEW
  QUOTED
  APPROVED
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

// المرحلة 2 من ميزة المذاخر: حالة الصنف داخل طلب المذخر.
enum WarehouseOrderItemStatus {
  REQUESTED
  AVAILABLE
  PARTIAL
  OUT_OF_STOCK
}

// المرحلة 1 من ميزة تتبّع المخزون (Pass A): اتجاه حركة المخزون — انظر WarehouseStockMove.
// ميزة المندوبين: REP_TRANSFER تُمثّل تحميل بضاعة من مخزون المذخر الرئيسي إلى
// سيارة مندوب (WarehouseRepStock) — صرف من مخزون المذخر تماماً كـ SHIPMENT،
// لكن الوجهة مندوب لا صيدلية. انظر تعليق ALTER TYPE في هجرة هذه الميزة لسبب
// أمان إضافة قيمة enum على PG 12+ داخل معاملة.
enum WarehouseStockMoveType {
  RECEIPT
  SHIPMENT
  ADJUSTMENT
  DAMAGE
  RETURN
  REP_TRANSFER
}

// المرحلة 2 من ميزة المذاخر: كتالوج أدوية المذخر — المطابقة عبر المستأجرين تتم على barcode
// (الخيار أ-1 من التقرير §4.1-أ) لأن GlobalDrug يوجد بعدة صفوف لنفس الدواء (عالمي + خاص لكل منظمة).
model WarehouseCatalogItem {
  id              String     @id @default(uuid())
  warehouseId     String
  drugId          String
  barcode         String
  price           Float
  isAvailable     Boolean    @default(true)
  lastPriceUpdate DateTime   @updatedAt
  // المرحلة 1 من ميزة تتبّع المخزون (Pass A): مرآة حقول Inventory.minStock/cost —
  // WarehouseCatalogItem هو معادل Inventory عند المذخر، فلا يُنشأ جدول مخزون منفصل.
  // isAvailable يبقى بمعناه الحالي كمفتاح "أعرض هذا الصنف" (قرار التاجر)؛ التوفر
  // الفعلي = isAvailable && كمية قابلة للبيع > 0 — انظر deriveAvailability في
  // app/lib/warehouse-stock.ts (تُطبَّق في المرحلة ب على مسارات الـ API/الواجهة).
  minStock  Int   @default(0) // حد إعادة الطلب
  costPrice Float @default(0) // كلفة الشراء — أساس احتساب هامش الربح

  // ميزة البونص: قاعدة بونص قياسية اختيارية لهذا الصنف («اشترِ bonusThreshold
  // خذ bonusQuantity مجاناً») — انظر app/lib/warehouse-bonus.ts (computeBonusUnits)
  // للقاعدة الحسابية الوحيدة. 0 في أي منهما يعني "لا قاعدة بونص" (لا 0 مجاني
  // لكل وحدة). هذه القاعدة **تقترح** فقط قيمة أولية عند تسعير طلب — القيمة
  // المعتمدة فعلياً تُخزَّن على WarehouseOrderItem.bonusQuantity أدناه، لأن
  // المذخر يفاوض حالة بحالة وقد يمنح بونصاً مختلفاً عن قاعدته المعلنة.
  bonusThreshold Int @default(0) // اشترِ هذا العدد…
  bonusQuantity  Int @default(0) // …واحصل على هذا العدد مجاناً

  // ميزة وحدة التسعير — قرار صاحب النظام 2026-09: «كل أسعار المذاخر أسعار
  // باكيت». PACKET صارت قاعدة غير مشروطة داخل toStripPrice (app/lib/pack-units.ts)
  // بصرف النظر عن قيمة هذا العمود، فلم يعد يُقرأ ولا يُكتَب في أي مسار. أُبقي
  // العمود بلا حذف لأنه nullable على قاعدة إنتاج حيّة (حذف عمود أخطر من تركه).
  priceUnit      String?
  // تعبئة المذخر المعلَنة لهذا الصنف — تُقارَن بـ GlobalDrug.unitsPerPack.
  // اختلافهما تعارض يوقف التحويل بدل ترجيح أحدهما. NULL في الاثنين = توقّف كذلك.
  unitsPerPack   Int?

  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  drug      GlobalDrug @relation(fields: [drugId], references: [id])
  batches   WarehouseBatch[]
  moves     WarehouseStockMove[]
  // المرحلة 5 (الصقل التجاري): أسعار شرائح لكل صنف — انظر تعليق WarehouseCatalogPrice أدناه.
  tierPrices WarehouseCatalogPrice[]
  // مشتريات المذخر وذممه الدائنة: بنود فواتير الشراء التي أنشأت دفعات لهذا الصنف.
  purchaseItems WarehousePurchaseItem[]
  // المندوبون (مذاخر B2B): بنود مبيعات ميدانية باعت هذا الصنف من مخزون مندوب.
  fieldSaleItems WarehouseFieldSaleItem[]

  @@unique([warehouseId, barcode])
  @@index([barcode])
  @@index([drugId])
}

// المرحلة 5 (الصقل التجاري): سعر صنف لشريحة تسعير محددة (يطابق
// WarehouseCustomer.priceTier نصاً — لا enum مشترك، فالشريحة نص حر يضبطه
// المذخر). resolveTierPrice() في app/lib/warehouse-pricing.ts هي القاعدة
// النقية الوحيدة التي تقرر أي سعر يُعرَض؛ صف بسعر <= 0 يُعامَل كخطأ إدخال
// ويُتجاهَل هناك (يسقط رجوعاً لسعر القائمة)، فلا يُحذَف من هذا الجدول تلقائياً.
model WarehouseCatalogPrice {
  id            String   @id @default(uuid())
  catalogItemId String
  tier          String // "GOLD" / "SILVER" ... مطابق لـ WarehouseCustomer.priceTier
  price         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogItem WarehouseCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([catalogItemId, tier])
  @@index([catalogItemId])
}

// المرحلة 1 من ميزة تتبّع المخزون (Pass A): معادل Batch عند المذخر — نفس أسماء
// الحقول بالضبط (batchNumber, expiryDate, quantity, initialQuantity, costPrice)
// كي يُقرأ النظامان بنفس المنطق؛ supplierId (Batch) → supplierName نصي حر هنا
// لأن المذخر لا يملك جدول Supplier لموردّيه (الشركات الدوائية التي يشتري منها).
model WarehouseBatch {
  id              String   @id @default(uuid())
  catalogItemId   String
  batchNumber     String
  expiryDate      DateTime
  quantity        Int
  // الكمية الأصلية عند الاستلام؛ quantity تُنقَص عند الشحن/التلف/التعديل، فالمستهلَك
  // = initialQuantity - quantity (مطابق لتعليق Batch.initialQuantity في Inventory).
  initialQuantity Int      @default(0)
  costPrice       Float    @default(0)
  supplierName    String?
  // مشتريات المذخر وذممه الدائنة: يتتبّع الدفعة إلى سطر فاتورة الشراء التي
  // أنشأتها، حين وُجدت — String? خام بلا @relation عمداً، بنفس انضباط
  // WarehouseStockMove.orderId أعلاه (فصل وحدة تتبّع المخزون عن وحدة
  // المشتريات، وتجنّب فرض قيد FK/cascade على جدول إنتاجي حي لحقل تتبّعي
  // بحت). دفعات مسار الاستلام اليدوي (stock/receipt) تبقى بلا قيمة هنا
  // (null) وتحتفظ بـ supplierName النصي الحر كما كانت دائماً.
  purchaseItemId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogItem WarehouseCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  moves       WarehouseStockMove[]
  // المندوبون (مذاخر B2B): أرصدة مندوبين حُمِّلوا من هذه الدفعة، وبنود مبيعات
  // ميدانية بيعت منها — انظر WarehouseRepStock / WarehouseFieldSaleItem.
  repStock       WarehouseRepStock[]
  fieldSaleItems WarehouseFieldSaleItem[]

  @@index([catalogItemId])
  @@index([catalogItemId, expiryDate])
  @@index([expiryDate, quantity])
}

// المرحلة 1 من ميزة تتبّع المخزون (Pass A): سجل تدقيق حركات المخزون — الصيدلية لا
// تملك مكافئاً لهذا، لكن المذخر يحتاجه للجرد وفض النزاعات مع الصيدليات. quantity
// دائماً موجبة؛ type يحمل الاتجاه (RECEIPT/RETURN تزيد، SHIPMENT/DAMAGE تنقص،
// ADJUSTMENT تصحيح جرد بأي اتجاه). orderId مقصود أن يبقى حقلاً نصياً بلا علاقة FK
// إلى WarehouseOrder (بلا @relation) لتجنّب إقران وحدة تتبّع المخزون بوحدة الطلبات
// — حركة SHIPMENT تُنشأ من مسار اعتماد/شحن الطلب، لكن هذا الملف لا يجب أن يعتمد
// على نموذج WarehouseOrder أو يفرض قيد حذف/تحديث متبادلاً معه.
model WarehouseStockMove {
  id            String                 @id @default(uuid())
  catalogItemId String
  batchId       String?
  type          WarehouseStockMoveType
  quantity      Int
  unitCost      Float?
  reason        String?
  actorName     String?
  orderId       String?
  createdAt     DateTime               @default(now())

  catalogItem WarehouseCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  batch       WarehouseBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([catalogItemId, createdAt])
}

// المرحلة 2 من ميزة المذاخر: سجل أحداث الطلب — أساس صفحة متابعة الحالة (Timeline).
model WarehouseOrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  actorType String
  actorName String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  order WarehouseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ==========================================================================
// Phase 2 من نظام المذاخر B2B — الحسابات والعملاء
// ==========================================================================
// المشكلة: المذخر لا يرى ماله إطلاقاً. الديون تُتبَّع في SupplierPayment
// العائد للصيدلية (supplierId → Supplier → Organization)، فتعرف الصيدلية ما
// تدين به للمذخر، بينما لا يملك المذخر أي نموذج مالي خاص به — لا يعرف من
// يدين له ولا بكم. الثلاثة نماذج التالية تسدّ هذه الفجوة على جانب المذخر
// حصراً، بلا أي مساس بـ SupplierPayment أو استبدال له.

// العلاقة التجارية بين مذخر وصيدلية: حدّ ائتمان (0 = بلا حد)، مهلة سداد
// بالأيام (0 = نقدي/بلا مهلة)، شريحة تسعير، وحظر. تُنشأ تلقائياً عند أول طلب
// يُعتمد (نفس نمط المورد المرآة في warehouse-purchase-bridge.ts — قيد تفرّد +
// معالجة P2002 عند التسابق) كي تتوفر شروط افتراضية من أول تعامل.
model WarehouseCustomer {
  id              String   @id @default(uuid())
  warehouseId     String
  organizationId  String
  creditLimit     Float    @default(0) // 0 = بلا حد ائتماني
  paymentTermDays Int      @default(0) // 0 = نقدي / بلا مهلة سداد
  // Remaining opening debt, added to invoice and field-sale receivables.
  // Opening repayments decrease it under the customer lock and preserve
  // before/after values in WarehouseSettlement. Direct replacement is blocked
  // after the first repayment; earlier amendments are audited.
  openingBalance  Float    @default(0)
  priceTier       String?
  isBlocked       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([warehouseId, organizationId])
  @@index([warehouseId])
  @@index([organizationId])
}

// فاتورة تُصدَر تلقائياً عند اعتماد الصيدلية للعرض (QUOTED → APPROVED)، داخل
// نفس معاملة إنشاء فاتورة الشراء المسودة (Purchase) في
// app/api/warehouses/orders/[id]/route.ts. total مُشتق حصراً من نفس
// effectiveLine()/plan.total المستخدَم هناك — لا يُعاد حسابه بقاعدة مختلفة،
// فلا يتفرّق الجانبان مالياً كما حدث سابقاً بين مسار العرض ومسار الاعتماد
// (انظر تعليق effectiveLine في warehouse-quote.ts). orderId فريد: فاتورة
// واحدة فقط لكل طلب مذخر — اعتماد الطلب مرتين (سباق أو خطأ) لا يجب أن يُنشئ
// فاتورة ثانية.
model WarehouseInvoice {
  id             String                 @id @default(uuid())
  warehouseId    String
  organizationId String
  orderId        String                 @unique
  invoiceNumber  String                 @unique
  total          Float
  paidAmount     Float                  @default(0)
  status         WarehouseInvoiceStatus @default(UNPAID)
  issuedAt       DateTime               @default(now())
  dueAt          DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  payments     WarehousePayment[]

  @@index([warehouseId, status])
  @@index([organizationId])
  @@index([dueAt])
}

enum WarehouseInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

// دفعة مُستلَمة على فاتورة مذخر. applyPayment() في app/lib/warehouse-accounts.ts
// يحسب paidAmount/status الجديدين بشكل نقي؛ الكتابة الفعلية على WarehouseInvoice
// تتم بتحديث ذري مشروط (compare-and-swap على paidAmount الحالي كما هو في WHERE)
// داخل معاملة واحدة مع إنشاء هذا السطر — نفس انضباط
// app/api/warehouse-portal/stock/adjust/route.ts ضد الدفعات المتزامنة.
model WarehousePayment {
  id          String   @id @default(uuid())
  // Required client-generated key; unique across all invoices to prevent a
  // retried payment POST from creating a second financial entry.
  idempotencyKey String? @unique
  invoiceId   String
  warehouseId String
  amount      Float
  method      String   @default("CASH")
  reference   String?
  notes       String?
  receivedAt  DateTime @default(now())
  actorName   String?
  createdAt   DateTime @default(now())

  invoice   WarehouseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])

  @@index([invoiceId])
  @@index([warehouseId, receivedAt])
}

// ==========================================================================
// مشتريات المذخر وذممه الدائنة (Warehouse Purchases & Payables)
// ==========================================================================
// كل ما سبق (WarehouseInvoice/WarehousePayment) يتتبّع ما يُدين به على
// المذخر (الذمم المدينة). هذا القسم هو الاتجاه المعاكس تماماً: ما يدين به
// المذخر نفسه لموردّيه (شركات الأدوية) — الذمم الدائنة. المورّد كان حتى الآن
// حقلاً نصياً حراً (WarehouseBatch.supplierName)، بلا كيان ولا فاتورة شراء
// خلفه، فلا كلفة شراء حقيقية موثَّقة ولا معرفة بما يُستحَق سداده لأي مورّد.
// applyPayment/computeInvoiceStatus/agingBucket/computeDueDate/
// summarizeReceivables في app/lib/warehouse-accounts.ts تُعاد استخدامها هنا
// حرفياً (الرياضيات نفسها بالاتجاه المعاكس) — لا نسخة موازية منها.

// الشركة الدوائية التي يشتري منها المذخر — معادل WarehouseCustomer بالاتجاه
// المعاكس، لكن بلا Organization خلفها (المورّد ليس بالضرورة عميلاً مسجَّلاً
// في هذا النظام، فهو نص/كيان محلي بحت لهذا المذخر).
model WarehouseSupplier {
  id            String   @id @default(uuid())
  warehouseId   String
  name          String
  phone         String?
  contactPerson String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  purchases WarehousePurchase[]

  @@unique([warehouseId, name])
  @@index([warehouseId])
}

// فاتورة شراء واردة من مورّد. total يُحسَب دائماً على الخادم من بنودها
// (WarehousePurchaseItem) — لا يُقبَل من جسم الطلب مباشرة، تماماً كما
// WarehouseInvoice.total يُشتق من effectiveLine()/plan.total ولا يُكتب حراً.
// status يعيد استخدام WarehouseInvoiceStatus القائم (نفس التعداد بالضبط)
// بدل تعداد مواز، لأن applyPayment/computeInvoiceStatus في
// warehouse-accounts.ts نقيّتان تماماً من اتجاه العلاقة (تُدخِلان
// {total, paidAmount} فقط) فتصلحان هنا بلا أي تعديل.
model WarehousePurchase {
  id            String                 @id @default(uuid())
  warehouseId   String
  supplierId    String
  invoiceNumber String // رقم فاتورة المورّد — ليس فريداً عالمياً، فقد يتكرر بين موردين مختلفين
  total         Float
  paidAmount    Float                  @default(0)
  status        WarehouseInvoiceStatus @default(UNPAID)
  issuedAt      DateTime               @default(now())
  dueAt         DateTime?
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  warehouse Warehouse                  @relation(fields: [warehouseId], references: [id])
  supplier  WarehouseSupplier          @relation(fields: [supplierId], references: [id])
  items     WarehousePurchaseItem[]
  payments  WarehouseSupplierPayment[]

  @@unique([warehouseId, supplierId, invoiceNumber])
  @@index([warehouseId, status])
  @@index([dueAt])
}

// سطر واحد في فاتورة شراء — ينشئ WarehouseBatch واحداً بالضبط عند إنشاء
// الفاتورة (POST /api/warehouse-portal/purchases). bonusQuantity هي الوحدات
// المجانية التي حصل عليها المذخر من المورّد على هذا السطر تحديداً: تدخل كمية
// المخزون الفعلية (quantity + bonusQuantity تصل كلها كوحدات إلى المخزن)، لكن
// total الفاتورة يحسب quantity × unitCost فقط — البونص مجاني حقاً، لا يُدفَع
// ثمنه مهما دخل المخزون. انظر computePurchaseTotal/purchaseStockUnits في
// app/lib/warehouse-purchases.ts للقاعدة الحسابية الوحيدة لكلا الرقمين.
model WarehousePurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String
  catalogItemId String
  batchNumber   String
  expiryDate    DateTime
  quantity      Int // الكمية المدفوعة الثمن فقط — تدخل حساب total
  unitCost      Float
  bonusQuantity Int      @default(0) // وحدات مجانية إضافية من المورّد — تدخل المخزون فقط، لا total

  purchase    WarehousePurchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  catalogItem WarehouseCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([catalogItemId])
}

// دفعة سداد صادرة من المذخر لمورّد على فاتورة شراء — الاتجاه المعاكس تماماً
// لـ WarehousePayment. نفس انضباط الكتابة الذرية المشروطة (compare-and-swap
// على paidAmount) في POST /api/warehouse-portal/purchases/[id]/payments،
// المطابق حرفياً لـ POST /api/warehouse-portal/invoices/[id]/payments.
model WarehouseSupplierPayment {
  id          String   @id @default(uuid())
  purchaseId  String
  warehouseId String
  amount      Float
  method      String   @default("CASH")
  reference   String?
  notes       String?
  paidAt      DateTime @default(now())
  actorName   String?
  createdAt   DateTime @default(now())

  purchase  WarehousePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])

  @@index([purchaseId])
  @@index([warehouseId, paidAt])
}

// ==========================================================================
// Phase 5 من نظام المذاخر B2B — الصقل التجاري: إرجاعات/إشعارات دائن
// ==========================================================================
// الصيدلية تطلب إرجاع صنف من طلب مُسلَّم/قيد التسليم؛ المذخر يقبل أو يرفض.
// warehouseId/orderId/organizationId أعمدة نصية بلا @relation عمداً — نفس
// انضباط WarehouseStockMove.orderId أعلاه (فصل وحدة الإرجاعات عن أي قيد
// حذف/تحديث متبادل مع Warehouse/WarehouseOrder/Organization). totalAmount
// ودرجات unitPrice تُشتق دائماً من effectiveLine() على الخادم عند الإنشاء —
// لا تُقبَل من جسم الطلب مباشرة (وإلا حدّدت الصيدلية قيمة إشعارها الدائن).
model WarehouseReturn {
  id             String   @id @default(uuid())
  creditNoteNumber String? @unique
  warehouseId    String
  orderId        String
  organizationId String
  reason         String?
  totalAmount    Float    @default(0)
  status         String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  actorName      String?
  purchaseId     String?
  creditBalance  Float    @default(0)
  refundedAmount Float    @default(0)
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items WarehouseReturnItem[]

  @@index([warehouseId, status])
  @@index([orderId])
}

model WarehouseReturnItem {
  id        String @id @default(uuid())
  returnId  String
  drugId    String
  barcode   String
  quantity  Int
  unitPrice Float
  pharmacyAllocations Json?
  disposition String @default("QUARANTINE")
  inspectionNote String?
  inspectedBy String?
  inspectedAt DateTime?
  warehouseAllocations Json?

  returnRecord WarehouseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

// Durable replay ledger for warehouse commands. Written in the same transaction
// as the money/stock mutation; the unique key is scoped to the warehouse.
model WarehouseOperation {
  id           String   @id @default(uuid())
  warehouseId  String
  key          String
  scope        String
  requestHash  String
  result       Json
  createdAt    DateTime @default(now())

  @@unique([warehouseId, key])
}

// =======================
// B2B Marketplace
// =======================
model MarketplaceListing {
  id          String                   @id @default(uuid())
  sellerId    String
  drugId      String
  quantity    Int
  unitPrice   Float
  minOrderQty Int                      @default(1)
  description String?
  expiryDate  DateTime?
  batchNumber String?
  status      MarketplaceListingStatus @default(ACTIVE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  seller Branch             @relation("MarketplaceSeller", fields: [sellerId], references: [id])
  drug   GlobalDrug         @relation(fields: [drugId], references: [id])
  orders MarketplaceOrder[]
}

enum MarketplaceListingStatus {
  ACTIVE
  SOLD_OUT
  EXPIRED
  ARCHIVED
}

/// One explicit purchase attempt (client idempotency key). The durable record of
/// its outcome, so a retry or a status query gets the original result: PROCESSING,
/// SUCCEEDED (with the order) or REJECTED (never executed). Owned by one user.
model MarketplaceOrderAttempt {
  id          String   @id @default(uuid())
  key         String   @unique
  userId      String
  buyerId     String
  requestHash String
  status      String   @default("PROCESSING") // PROCESSING | SUCCEEDED | REJECTED
  orderId     String?  @unique
  httpStatus  Int?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model MarketplaceOrder {
  id         String                 @id @default(uuid())
  listingId  String
  buyerId    String
  quantity   Int
  totalPrice Float
  status     MarketplaceOrderStatus @default(PENDING)
  notes      String?
  // Client retry key: a resend returns the original order; the same key with a
  // different request (requestHash) is refused.
  idempotencyKey String?                @unique
  requestHash    String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  listing MarketplaceListing @relation(fields: [listingId], references: [id])
  buyer   Branch             @relation("MarketplaceBuyer", fields: [buyerId], references: [id])
}

enum MarketplaceOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

// NOTE: Tenant model removed — Organization is the single SaaS tenant entity.
// The word 'tenant' in API routes refers to JSON response shapes, not this DB model.

// =======================
// Patient App
// =======================
model PatientAppUser {
  id               String            @id @default(uuid())
  phone            String            @unique
  name             String?
  email            String?
  password         String
  dateOfBirth      DateTime?
  gender           String?
  bloodType        String?
  allergies        String?
  chronicDiseases  String?
  emergencyContact String?
  isVerified       Boolean           @default(false)
  expoPushToken    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           PatientAppOrder[]
}

model PatientAppOrder {
  id              String                @id @default(uuid())
  patientId       String
  branchId        String?
  prescriptionUrl String?
  status          PatientAppOrderStatus @default(PENDING)
  totalAmount     Float?
  deliveryAddress String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  patient PatientAppUser        @relation(fields: [patientId], references: [id])
  branch  Branch?               @relation(fields: [branchId], references: [id])
  items   PatientAppOrderItem[]
}

model PatientAppOrderItem {
  id       String @id @default(uuid())
  orderId  String
  drugId   String
  quantity Int
  price    Float

  order PatientAppOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  drug  GlobalDrug      @relation(fields: [drugId], references: [id])
}

enum PatientAppOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

// =======================
// WhatsApp Templates
// =======================
model WhatsAppTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  bodyAr    String
  bodyEn    String?
  variables String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// AI Demand Forecasting
// =======================
model DemandForecast {
  id              String   @id @default(uuid())
  drugId          String
  branchId        String?
  forecastDate    DateTime
  predictedQty    Int
  confidenceLevel Float    @default(0.5)
  actualQty       Int?
  algorithm       String   @default("moving_average")
  createdAt       DateTime @default(now())

  drug   GlobalDrug @relation(fields: [drugId], references: [id])
  branch Branch?    @relation(fields: [branchId], references: [id])

  @@index([drugId, forecastDate])
  @@index([branchId, forecastDate])
}

// =======================
// Licensing System
// =======================
model DeviceLicense {
  id                       String    @id @default(uuid())
  licenseKey               String    @unique
  branchId                 String
  hardwareId               String?
  deviceName               String?
  isActive                 Boolean   @default(true)
  suspendedByOrgSuspension Boolean   @default(false)
  expiresAt                DateTime?
  activatedAt              DateTime?
  lastSeenAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  signingKey DeviceSigningKey?

  @@index([licenseKey])
  @@index([hardwareId])
  @@index([branchId])
  @@index([branchId, isActive])
}

model DeviceSigningKey {
  id String @id @default(uuid())
  licenseId String @unique
  license DeviceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  publicKey String
  fingerprint String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  approvedAt DateTime?
  approvedBy String?
  nonces DeviceSigningNonce[]
}

model DeviceSigningNonce {
  keyId String
  nonce String
  expiresAt DateTime
  key DeviceSigningKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  @@id([keyId, nonce])
  @@index([expiresAt])
}

// =======================
// Offline (standalone) desktop licenses
// Issued by the super-admin for the offline-only desktop product. The signed
// RS256 code is verified locally on the customer's device (no server calls);
// this table only tracks what was issued, to whom, and lets us re-copy a code.
// =======================
model OfflineLicense {
  id           String    @id @default(uuid())
  pharmacyName String
  licensedTo   String?
  hardwareId   String    // device fingerprint this license is locked to
  plan         String    @default("PERPETUAL") // PERPETUAL or ANNUAL
  expiresAt    DateTime? // null for perpetual
  licenseCode  String    @db.Text // the signed JWT handed to the customer
  notes        String?
  revoked      Boolean   @default(false) // record-keeping only (offline can't enforce)
  issuedById   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([hardwareId])
  @@index([createdAt])
}

// =======================
// Dynamic Subscriptions
// =======================
model SubscriptionPlan {
  id             String         @id @default(uuid())
  name           String
  price          Float          @default(0)
  maxBranches    Int            @default(1)
  maxUsers       Int            @default(3)
  maxDevices     Int            @default(1) // Max cashier device licenses
  maxMobileUsers Int            @default(1) // Max concurrent mobile app users
  features       Json?
  isActive       Boolean        @default(true)
  isPopular      Boolean        @default(false) // Highlighted as most popular on pricing page
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizations Organization[]
}

// =======================
// Payment Transactions
// =======================
model PaymentTransaction {
  id                   String                   @id @default(uuid())
  organizationId       String
  amount               Float
  currency             String                   @default("IQD")
  gateway              PaymentGateway           @default(ZAINCASH)
  gatewayTransactionId String?                  @unique
  status               PaymentTransactionStatus @default(PENDING)
  renewalMonths        Int                      @default(1)
  newExpiresAt         DateTime?
  metadata             Json?
  initiatedAt          DateTime                 @default(now())
  completedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([gatewayTransactionId])
  @@index([status])
}

enum PaymentGateway {
  ZAINCASH
  STRIPE
  MANUAL
}

enum PaymentTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

// =======================
// In-App Notifications
// =======================

enum NotificationType {
  LOW_STOCK
  EXPIRY
  NEW_PURCHASE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  branchId  String?
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([branchId, createdAt])
  @@index([createdAt])
}

// =======================
// Mobile Session Tracking
// =======================
model MobileSession {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  deviceToken    String   @unique  // one row per device installation
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@index([organizationId, isActive])
  @@index([userId])
  @@index([lastSeenAt])
}


// =======================
// AI Usage Tracking
// =======================
model AiUsageLog {
  id             String       @id @default(uuid())
  organizationId String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model PrescriptionScanLog {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

// ==========================================================================
// المندوبون (Field Sales Reps) — مذاخر B2B
// ==========================================================================
// المشكلة: نظامنا يفترض نموذج بيع واحد — صيدلية على منصّتنا ترسل طلباً
// والمذخر يرد عليه (WarehouseOrder/WarehouseInvoice أعلاه). لكن مذاخر الأدوية
// العراقية تبيع بالدرجة الأولى عبر مندوبين ميدانيين يحملون بضاعة في سياراتهم
// ويزورون صيدليات — أغلبها ليست على منصّتنا إطلاقاً. بدون هذا القسم، لا يمكن
// للمذخر خدمة عملائه خارج المنصّة على الإطلاق.
//
// البنية: WarehouseRepStock هي "بضاعة السيارة" — رصيد مندوب من دفعة معيّنة،
// مُحمَّل من مخزون المذخر الرئيسي (WarehouseBatch) عبر حركة REP_TRANSFER.
// WarehouseFieldSale/WarehouseFieldSaleItem تُطابقان WarehouseInvoice بلا طلب
// خلفهما (لا WarehouseOrder — البيع الميداني فوري بلا تفاوض/تسعير مسبق)؛
// customerName نصي حر إلزامي دائماً (المندوب يكتب اسم الصيدلية كما يعرفها)،
// وorganizationId اختياري فقط حين تكون تلك الصيدلية فعلاً على منصّتنا.
// WarehouseRepCollection تحصيل نقدي من المندوب — قد يُطبَّق على فاتورة ميدانية
// محدَّدة (عبر applyPayment/computeInvoiceStatus من warehouse-accounts.ts،
// بلا نسخة موازية) أو يُسجَّل كتحصيل غير مخصَّص لفاتورة بعينها.
//
// العمولة (SALES/PROFIT/COLLECTION) منطق نقي بالكامل في app/lib/warehouse-reps.ts
// — لا يُخزَّن هنا أي رقم عمولة محسوب، فقط مدخلات الحساب (commissionBasis/Rate).

enum CommissionBasis {
  SALES // نسبة من إجمالي المبيعات
  PROFIT // نسبة من الربح (سعر - كلفة) × الكمية
  COLLECTION // نسبة من النقد المحصَّل فعلاً — الأهم تجارياً لأنها تربط الأجر بالتحصيل الفعلي لا مجرد تسجيل الدين
}

// المندوب — قد يملك حساب دخول اختياري (userId، دور WAREHOUSE) لتسجيل مبيعاته
// وتحصيلاته بنفسه عبر البوابة، أو يبقى بلا حساب ويُدار بالكامل من طرف المالك/المدير.
model WarehouseRep {
  id              String          @id @default(uuid())
  warehouseId     String
  userId          String?         @unique
  name            String
  phone           String?
  commissionBasis CommissionBasis @default(SALES)
  commissionRate  Float           @default(0) // نسبة مئوية؛ <= 0 يعني "لا عمولة مُعدَّة" (انظر computeCommission)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  warehouse   Warehouse                @relation(fields: [warehouseId], references: [id])
  user        User?                    @relation(fields: [userId], references: [id])
  stock       WarehouseRepStock[]
  fieldSales  WarehouseFieldSale[]
  collections WarehouseRepCollection[]

  @@index([warehouseId, isActive])
}

// بضاعة السيارة — رصيد مندوب من دفعة معيّنة، مُحمَّل من WarehouseBatch عبر
// حركة REP_TRANSFER. مفتاح تفرّد (repId, batchId) واحد: تحميل إضافي لنفس
// المندوب من نفس الدفعة يزيد الكمية على نفس الصف، لا يُنشئ صفاً موازياً.
model WarehouseRepStock {
  id        String   @id @default(uuid())
  repId     String
  batchId   String
  quantity  Int
  updatedAt DateTime @updatedAt

  rep   WarehouseRep   @relation(fields: [repId], references: [id], onDelete: Cascade)
  batch WarehouseBatch @relation(fields: [batchId], references: [id])

  @@unique([repId, batchId])
  @@index([repId])
}

// فاتورة بيع ميدانية — تُطابق WarehouseInvoice بلا WarehouseOrder خلفها (بيع
// فوري بلا تفاوض مسبق). customerName نصي حر إلزامي دائماً؛ organizationId
// اختياري فقط حين تكون الصيدلية فعلاً على منصّتنا (WarehouseCustomer/Organization).
// total محسوب دائماً من البنود على الخادم — لا يُقبَل من جسم الطلب مباشرة.
model WarehouseFieldSale {
  id             String                 @id @default(uuid())
  warehouseId    String
  repId          String
  organizationId String?
  customerName   String
  invoiceNumber  String                 @unique
  total          Float
  paidAmount     Float                  @default(0)
  status         WarehouseInvoiceStatus @default(UNPAID)
  soldAt         DateTime               @default(now())
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  warehouse    Warehouse                @relation(fields: [warehouseId], references: [id])
  rep          WarehouseRep             @relation(fields: [repId], references: [id])
  organization Organization?            @relation(fields: [organizationId], references: [id])
  items        WarehouseFieldSaleItem[]
  collections  WarehouseRepCollection[]

  @@index([warehouseId, status])
  @@index([repId, soldAt])
}

// سطر بيع ميداني — يخصم من WarehouseRepStock (بضاعة المندوب) حصراً، لا من
// مخزون المذخر الرئيسي مباشرة. unitCost لقطة كلفة الدفعة وقت البيع (لازمة
// لعمولة الربح لاحقاً — تغيّر كلفة الكتالوج بعدها لا يُعيد كتابة التاريخ).
// bonusQuantity تخصم مخزوناً بلا إيراد — نفس قاعدة WarehouseOrderItem.bonusQuantity
// (انظر computeFieldSaleProfit في app/lib/warehouse-reps.ts).
model WarehouseFieldSaleItem {
  id            String @id @default(uuid())
  fieldSaleId   String
  batchId       String
  catalogItemId String
  quantity      Int
  bonusQuantity Int    @default(0)
  unitPrice     Float
  unitCost      Float

  fieldSale   WarehouseFieldSale   @relation(fields: [fieldSaleId], references: [id], onDelete: Cascade)
  batch       WarehouseBatch       @relation(fields: [batchId], references: [id])
  catalogItem WarehouseCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([fieldSaleId])
}

// تحصيل نقدي من المندوب — إن حُدِّد fieldSaleId يُطبَّق على تلك الفاتورة
// الميدانية تحديداً (عبر applyPayment/computeInvoiceStatus من
// warehouse-accounts.ts، بلا نسخة موازية)؛ وإلا فهو تحصيل غير مخصَّص لفاتورة
// بعينها (دفعة على الحساب العام للمندوب لدى المذخر).
model WarehouseRepCollection {
  documentNumber String @unique @default(dbgenerated("next_document_reference('COL'::text)"))
  id          String   @id @default(uuid())
  repId       String
  warehouseId String
  fieldSaleId String?
  amount      Float
  notes       String?
  collectedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  rep       WarehouseRep        @relation(fields: [repId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  fieldSale WarehouseFieldSale? @relation(fields: [fieldSaleId], references: [id])

  @@index([repId, collectedAt])
}

// Append-only settlement vouchers. References prevent a second posting even
// when the operator retries from another device with a new operation key.
model WarehouseSettlement {
  documentNumber String @unique @default(dbgenerated("next_document_reference('VCH'::text)"))
  id             String   @id @default(uuid())
  warehouseId    String
  organizationId String?
  kind           String
  reference      String
  sourceId       String
  amount         Float
  direction      String
  actorId        String
  details        Json
  createdAt      DateTime @default(now())

  @@unique([warehouseId, kind, reference])
  @@index([warehouseId, createdAt])
  @@index([warehouseId, sourceId])
}

/// N02-R2: first time the server saw a synced cash movement whose sale/return
/// had not reached the cloud yet. The review deadline counts from here, never
/// from the device clock. Rows are removed once the document arrives.
model SyncMovementWait {
  transactionId String   @id
  branchId      String
  firstSeenAt   DateTime @default(now())

  @@index([branchId])
}
