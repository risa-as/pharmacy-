{
    "name": "desktop",
    "version": "1.0.5",
    "description": "Faramace POS — نظام إدارة الصيدليات",
    "author": "Faramace",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "clean": "node scripts/clean-release.mjs",
        "build": "node scripts/clean-release.mjs && prisma generate && tsc && vite build && electron-builder",
        "build:fresh": "node scripts/clean-release.mjs && prisma generate && tsc && vite build && electron-builder --win nsis --config.directories.output=../../../FaramaceBuilds/desktop-installer-new",
        "release": "node scripts/clean-release.mjs && prisma generate && tsc && vite build && node scripts/publish.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "lint": "eslint .",
        "prisma:seed-interactions": "node prisma/seed-interactions.js"
    },
    "build": {
        "appId": "com.faramace.desktop",
        "productName": "Faramace POS",
        "directories": {
            "output": "../../../FaramaceBuilds/desktop"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "risa-as",
                "repo": "pharmacy-"
            }
        ],
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "node_modules/.prisma/**/*",
            "node_modules/@prisma/client/**/*",
            "node_modules/prisma/**/*",
            "prisma/**/*",
            "!node_modules/**/node_modules",
            "!node_modules/**/*.md",
            "!node_modules/**/*.map"
        ],
        "asarUnpack": [
            "node_modules/.prisma/**/*",
            "node_modules/@prisma/client/query-engine*"
        ],
        "extraResources": [
            {
                "from": "prisma",
                "to": "prisma",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "node_modules/.prisma/desktop-client",
                "to": "prisma-client",
                "filter": [
                    "*.js",
                    "*.json",
                    "runtime/**",
                    "query_engine-windows.dll.node"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "public/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Faramace POS",
            "include": "build/installer.nsh"
        },
        "portable": {
            "splashImage": null
        }
    },
    "dependencies": {
        "@faramace/shared": "workspace:*",
        "@faramace/ui": "workspace:*",
        "@prisma/client": "5",
        "@types/bcryptjs": "^3.0.0",
        "bcryptjs": "^3.0.3",
        "clsx": "^2.1.0",
        "electron-store": "^8.1.0",
        "electron-updater": "^6.8.9",
        "jose": "^6.1.3",
        "lucide-react": "^0.330.0",
        "node-fetch": "2",
        "node-machine-id": "^1.1.12",
        "prisma": "5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hotkeys-hook": "^4.5.0",
        "tailwind-merge": "^2.2.1"
    },
    "devDependencies": {
        "@types/node-fetch": "^2.6.13",
        "@types/react": "^18.2.55",
        "@types/react-dom": "^18.2.19",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "electron": "^28.2.1",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.35",
        "sharp": "^0.34.5",
        "tailwindcss": "^3.3.0",
        "to-ico": "^1.1.5",
        "typescript": "^5.2.2",
        "vite": "^5.1.0",
        "vite-plugin-electron": "^0.28.2",
        "vite-plugin-electron-renderer": "^0.14.5"
    }
}