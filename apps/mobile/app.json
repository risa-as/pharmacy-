{
  "expo": {
    "name": "Faramace",
    "slug": "faramace",
    "version": "1.0.2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/808c2b2a-ec42-46c1-8a3a-0e2054b7ea40",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 1500
    },
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "faramace",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faramace.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "نستخدم الكاميرا لمسح باركود المنتجات وتصوير الوصفات لقراءتها بعد موافقتك على المشاركة.",
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": false, "NSAllowsLocalNetworking": true },
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#22C55E"
      },
      "package": "com.faramace.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F7575",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نستخدم الكاميرا لمسح باركود المنتجات وتصوير الوصفات لقراءتها بعد موافقتك على المشاركة.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      ["expo-image-picker", {
        "photosPermission": "نستخدم الصورة التي تختارها من مكتبتك لقراءة الوصفة بعد موافقتك على المشاركة.",
        "cameraPermission": "نستخدم الكاميرا لمسح باركود المنتجات وتصوير الوصفات لقراءتها بعد موافقتك على المشاركة.",
        "microphonePermission": false
      }],
      ["expo-local-authentication", {
        "faceIDPermission": "نستخدم Face ID على جهازك لتأكيد الدخول السريع؛ لا ترسل صورة الوجه أو بيانات البصمة إلى فاراماس."
      }],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "808c2b2a-ec42-46c1-8a3a-0e2054b7ea40"
      }
    }
  }
}
