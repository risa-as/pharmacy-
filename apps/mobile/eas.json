{
    "cli": {
        "version": ">= 25.2.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "channel": "development",
            "environment": "development",
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "channel": "preview",
            "environment": "preview",
            "autoIncrement": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "node": "20.19.4",
            "prebuildCommand": "prebuild --clean --no-install",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://app.faramace.com/api"
            }
        },
        "production": {
            "channel": "production",
            "environment": "production",
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle"
            },
            "node": "20.19.4",
            "prebuildCommand": "prebuild --clean --no-install",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://app.faramace.com/api"
            }
        },
        "production-apk": {
            "extends": "production",
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6827000365",
                "appleTeamId": "R2K7M7LNGU"
            }
        }
    }
}
