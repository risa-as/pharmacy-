{
  "name": "faramace-mobile",
  "version": "1.0.2",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "update:production": "node ../../scripts/check-mobile-runtime.mjs && eas update --channel production --platform all --non-interactive",
    "update:preview": "node ../../scripts/check-mobile-runtime.mjs && eas update --channel preview --platform all --non-interactive",
    "build:production:apk": "eas build --platform android --profile production-apk"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native/assets-registry": "0.76.6",
    "@react-navigation/native": "^7.0.14",
    "buffer": "^6.0.3",
    "expo": "~54.0.38",
    "expo-asset": "~12.0.14",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "^15.0.8",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.24.0",
    "@types/react": "~19.1.17",
    "tailwindcss": "3.3.2",
    "typescript": "^5.1.3"
