{
  "name": "faramace",
  "private": true,
  "scripts": {
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "audit:prod": "node scripts/audit-prod.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "latest",
    "vitest": "^4.1.8",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@8.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "uuid@^7": "11.1.1",
      "uuid@^8": "11.1.1",
      "decode-uri-component": "0.5.0",
      "@xmldom/xmldom": "0.8.15",
      "protobufjs": "^7.6.6",
      "@grpc/grpc-js": "^1.14.4",
      "sharp": "^0.35.4",
      "dompurify": "^3.4.15",
      "fflate": "^0.8.3",
      "tmp": "^0.2.7",
      "minimist": "^1.2.8",
      "nanoid": "^3.3.18",
      "minimatch@^3": "^3.1.4",
      "minimatch@^5": "^5.1.8",
      "minimatch@^9": "^9.0.7",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^2": "^2.1.4",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "postcss-selector-parser@^6": "^6.1.3",
      "@babel/core": "7.29.7",
      "@tootallnate/once": "2.0.1",
      "ajv@^8": "8.20.0",
      "brace-expansion@^5": "5.0.9",
      "browserslist": "4.28.9",
      "effect": "3.22.1",
      "fast-uri": "3.1.7",
      "js-yaml@^3": "3.15.2",
      "js-yaml@^4": "4.3.2",
      "node-forge": "1.4.0",
      "postcss": "8.5.28",
      "shell-quote": "1.10.0",
      "tar@^7": "7.5.22",
      "undici@^6": "6.28.1",
      "ws@^6": "6.2.6",
      "ws@^7": "7.5.13",
      "ws@^8": "8.21.3",
      "yaml": "2.9.0"
    },
    "patchedDependencies": {
      "decode-uri-component@0.5.0": "patches/decode-uri-component@0.5.0.patch",
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  }
}
